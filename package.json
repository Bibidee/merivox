  },
  "devDependencies": {
    "@types/node": "24.5.2",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "eslint": "9.36.0",
    "eslint-config-next": "16.3.2",
    "genlayer": "0.39.1",
    "tsx": "^4.19.2",
    "typescript": "5.9.2"
  },
  "type": "module"
}
